+		buildToolbar(host, controller);
+		const arrow = host.querySelector<HTMLButtonElement>('button[aria-label="Add page from a template"]')!;
+		expect(() => arrow.click()).not.toThrow();
+		expect(shownMenus[0]!.items).toEqual([]);
+	});
+});
